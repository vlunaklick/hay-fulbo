{
  "name": "hay-fulbo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "lucide-react": "^1.27.0",
      "next": "^16.2.12",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@tanstack/react-query": "^5.101.4",
      "better-auth": "1.6.25",
      "@tanstack/react-form": "^1.33.2",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.25"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "BETTER_AUTH_SECRET=build-time-placeholder-secret-not-used-at-runtime SKIP_ENV_VALIDATION=1 turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native",
    "dev:web": "turbo run dev -F web",
    "db:push": "turbo run db:push -F @hay-fulbo/db",
    "db:studio": "turbo run db:studio -F @hay-fulbo/db",
    "db:generate": "turbo run db:generate -F @hay-fulbo/db",
    "db:migrate": "turbo run db:migrate -F @hay-fulbo/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "coolify:test": "node --test ops/coolify/*.test.mjs",
    "coolify:plan": "node ops/coolify/reconcile.mjs --dry-run",
    "coolify:apply": "node ops/coolify/reconcile.mjs --apply",
    "coolify:deploy": "node ops/coolify/deploy.mjs",
    "coolify:smoke": "node ops/coolify/smoke.mjs",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@hay-fulbo/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hay-fulbo/config": "workspace:*",
    "@types/node": "^22.20.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.3"
}
