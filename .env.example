# Local PostgreSQL administration and migration role.
POSTGRES_PASSWORD=change-me-for-local-development

# Local non-owner PostgreSQL role used by the application.
POSTGRES_RUNTIME_PASSWORD=change-me-runtime-password-32-plus
POSTGRES_PORT=5432
WEB_PORT=3001

# Application connection: production must use a NOSUPERUSER NOBYPASSRLS role.
DATABASE_URL=postgresql://hay_fulbo_runtime:change-me@127.0.0.1:5432/hay-fulbo

# Migration connection: production must use the schema-owner migration role.
MIGRATION_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/hay-fulbo

# Used only during startup to provision/rotate the restricted runtime role.
RUNTIME_DATABASE_PASSWORD=replace-with-at-least-32-random-characters

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Optional: extra origins allowed to reach the web dev server (comma-separated),
# e.g. a Tailscale IP or MagicDNS hostname for testing from another device.
# ALLOWED_DEV_ORIGINS=100.x.y.z,your-host.tailnet-name.ts.net
NODE_ENV=development
